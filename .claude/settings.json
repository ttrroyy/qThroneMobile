{
  "env": {
    "PONYTAIL_DEFAULT_MODE": "full",
    "PONYTAIL_MAP": "0"
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$HOME/.local/bin/rtk\" ]; then exec \"$HOME/.local/bin/rtk\" hook claude; fi"
          }
        ]
      }
    ]
  }
}
