<resources>
    <style name="MobileControls">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.SagerNet</item>
        <item name="switchStyle">@style/MobileSwitch</item>
        <item name="android:switchStyle">@style/MobilePlatformSwitch</item>
        <item name="textInputStyle">@style/MobileTextInput</item>
        <item name="colorControlActivated">?attr/colorAccent</item>
        <!-- Check boxes share the switch's rounded square; dialogs and menus use the same box. -->
        <item name="checkboxStyle">@style/MobileCheckBox</item>
        <item name="android:checkboxStyle">@style/MobilePlatformCheckBox</item>
        <item name="android:listChoiceIndicatorMultiple">@drawable/mobile_checkbox</item>
        <item name="listChoiceIndicatorMultipleAnimated">@drawable/mobile_checkbox</item>
    </style>
    <style name="MobileCheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="useMaterialThemeColors">false</item>
        <item name="buttonCompat">@drawable/mobile_checkbox</item>
        <item name="buttonTint">@null</item>
    </style>
    <style name="MobilePlatformCheckBox" parent="android:Widget.Material.CompoundButton.CheckBox">
        <item name="android:button">@drawable/mobile_checkbox</item>
        <item name="android:buttonTint">@null</item>
    </style>
    <style name="MobileSwitch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="useMaterialThemeColors">false</item>
        <item name="android:thumb">@drawable/mobile_switch_thumb</item>
        <item name="track">@drawable/mobile_switch_track</item>
        <item name="thumbTint">@color/mobile_switch_thumb_tint</item>
        <item name="trackTint">@null</item>
        <item name="splitTrack">false</item>
        <item name="switchMinWidth">48dp</item>
        <item name="switchPadding">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="MobilePlatformSwitch" parent="android:Widget.Material.CompoundButton.Switch">
        <item name="android:thumb">@drawable/mobile_switch_thumb</item>
        <item name="android:track">@drawable/mobile_switch_track</item>
        <item name="android:thumbTint">@color/mobile_switch_thumb_tint</item>
        <item name="android:trackTint">@null</item>
        <item name="android:splitTrack">false</item>
        <item name="android:switchMinWidth">48dp</item>
        <item name="android:switchPadding">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="MobileTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/mobile_input_outline</item>
        <item name="hintTextColor">?attr/colorAccent</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>
