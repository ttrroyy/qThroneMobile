<!-- Multiplied over the knob: only its opacity changes, so the light on it stays. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="#61FFFFFF" />
    <item android:state_checked="true" android:color="#FFFFFFFF" />
    <item android:color="#CCFFFFFF" />
</selector>
