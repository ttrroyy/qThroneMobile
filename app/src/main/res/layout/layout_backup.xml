<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:id="@+id/backup_menu" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" app:cardCornerRadius="?attr/qtRowRadius" app:cardElevation="0dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/backup_tab_local" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="start|center_vertical" android:text="Локально" android:textSize="16sp" android:textAllCaps="false" android:maxLines="4" app:icon="@drawable/ic_mobile_backup" app:iconTint="#67CCE3" app:iconPadding="12dp" app:iconGravity="start" app:cornerRadius="?attr/qtRowRadius" app:strokeWidth="0dp" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" app:cardCornerRadius="?attr/qtRowRadius" app:cardElevation="0dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/backup_tab_webdav" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="start|center_vertical" android:text="WebDAV" android:textSize="16sp" android:textAllCaps="false" android:maxLines="4" app:icon="@drawable/ic_mobile_globe" app:iconTint="#67CCE3" app:iconPadding="12dp" app:iconGravity="start" app:cornerRadius="?attr/qtRowRadius" app:strokeWidth="0dp" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" app:cardCornerRadius="?attr/qtRowRadius" app:cardElevation="0dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/reset_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="start|center_vertical" android:text="@string/reset_settings" android:textSize="16sp" android:textAllCaps="false" android:maxLines="4" app:icon="@drawable/ic_mobile_refresh" app:iconTint="#67CCE3" app:iconPadding="12dp" app:iconGravity="start" app:cornerRadius="?attr/qtRowRadius" app:strokeWidth="0dp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout android:id="@+id/backup_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:id="@+id/backup_local_page" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Состав резервной копии" android:textSize="16sp" android:textStyle="bold" android:tag="backup_section" android:textColor="#67CCE3" android:paddingStart="6dp" android:paddingTop="12dp" android:paddingBottom="6dp" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" app:cardCornerRadius="?attr/qtRowRadius" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_mobile_subscriptions" android:tint="#67CCE3" android:importantForAccessibility="no" android:layout_marginEnd="12dp" />
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/backup_profiles" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:checked="true" android:text="@string/backup_part_profiles" android:textSize="16sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" app:cardCornerRadius="?attr/qtRowRadius" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_mobile_route" android:tint="#67CCE3" android:importantForAccessibility="no" android:layout_marginEnd="12dp" />
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/backup_routes" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:checked="true" android:text="@string/backup_part_routes" android:textSize="16sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" app:cardCornerRadius="?attr/qtRowRadius" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="0dp" android:paddingBottom="0dp" android:orientation="horizontal">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_mobile_settings" android:tint="#67CCE3" android:importantForAccessibility="no" android:layout_marginEnd="12dp" />
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/backup_settings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:checked="true" android:text="@string/backup_part_settings" android:textSize="16sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/backup_local_summary" android:textSize="13sp" android:padding="6dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Действия" android:textSize="16sp" android:textStyle="bold" android:tag="backup_section" android:textColor="#67CCE3" android:paddingStart="6dp" android:paddingTop="12dp" android:paddingBottom="6dp" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" app:cardCornerRadius="?attr/qtRowRadius" app:cardElevation="0dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/backup_create" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="start|center_vertical" android:text="@string/backup_create" android:textSize="16sp" android:textAllCaps="false" android:maxLines="4" app:icon="@drawable/ic_mobile_backup" app:iconTint="#67CCE3" app:iconPadding="12dp" app:iconGravity="start" app:cornerRadius="?attr/qtRowRadius" app:strokeWidth="0dp" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" app:cardCornerRadius="?attr/qtRowRadius" app:cardElevation="0dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/backup_share" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="start|center_vertical" android:text="@string/share" android:textSize="16sp" android:textAllCaps="false" android:maxLines="4" app:icon="@drawable/ic_mobile_share" app:iconTint="#67CCE3" app:iconPadding="12dp" app:iconGravity="start" app:cornerRadius="?attr/qtRowRadius" app:strokeWidth="0dp" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" app:cardCornerRadius="?attr/qtRowRadius" app:cardElevation="0dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/backup_restore" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="start|center_vertical" android:text="@string/backup_restore" android:textSize="16sp" android:textAllCaps="false" android:maxLines="4" app:icon="@drawable/ic_mobile_refresh" app:iconTint="#67CCE3" app:iconPadding="12dp" app:iconGravity="start" app:cornerRadius="?attr/qtRowRadius" app:strokeWidth="0dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:id="@+id/backup_webdav_page" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WebDAV" android:textSize="16sp" android:textStyle="bold" android:tag="backup_section" android:textColor="#67CCE3" android:paddingStart="6dp" android:paddingTop="12dp" android:paddingBottom="6dp" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" app:cardCornerRadius="?attr/qtRowRadius" app:cardElevation="0dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/backup_to_webdav" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="start|center_vertical" android:text="@string/backup_to_webdav" android:textSize="16sp" android:textAllCaps="false" android:maxLines="4" app:icon="@drawable/ic_mobile_backup" app:iconTint="#67CCE3" app:iconPadding="12dp" app:iconGravity="start" app:cornerRadius="?attr/qtRowRadius" app:strokeWidth="0dp" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" app:cardCornerRadius="?attr/qtRowRadius" app:cardElevation="0dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/restore_from_webdav" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="start|center_vertical" android:text="@string/restore_from_webdav" android:textSize="16sp" android:textAllCaps="false" android:maxLines="4" app:icon="@drawable/ic_mobile_refresh" app:iconTint="#67CCE3" app:iconPadding="12dp" app:iconGravity="start" app:cornerRadius="?attr/qtRowRadius" app:strokeWidth="0dp" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" app:cardCornerRadius="?attr/qtRowRadius" app:cardElevation="0dp">
                    <com.google.android.material.button.MaterialButton android:id="@+id/webdav_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:gravity="start|center_vertical" android:text="@string/webdav_settings" android:textSize="16sp" android:textAllCaps="false" android:maxLines="4" app:icon="@drawable/ic_mobile_settings" app:iconTint="#67CCE3" app:iconPadding="12dp" app:iconGravity="start" app:cornerRadius="?attr/qtRowRadius" app:strokeWidth="0dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
