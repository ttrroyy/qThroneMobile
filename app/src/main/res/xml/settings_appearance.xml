  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:defaultValue="" app:entries="@array/language_entries" app:entryValues="@array/language_values" app:key="appLanguage" app:icon="@drawable/ic_mobile_language" app:title="@string/language" app:useSimpleSummaryProvider="true" />
 </PreferenceCategory>
 <PreferenceCategory app:title="@string/cag_notification">
  <SwitchPreference app:defaultValue="false" app:key="qmobileNotificationSpeed" app:icon="@drawable/ic_baseline_speed_24" app:title="@string/qmobile_notification_speed" />
