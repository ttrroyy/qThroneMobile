  <moe.matsuri.nb4a.ui.ColorPickerPreference app:defaultValue="19" app:title="@string/qmobile_color" app:key="appTheme" app:icon="@drawable/ic_mobile_palette" />
  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:key="qmobileSurfaceTheme" app:icon="@drawable/ic_mobile_theme" app:title="@string/theme" app:persistent="false" app:entries="@array/qmobile_surface_themes" app:entryValues="@array/qmobile_surface_values" app:useSimpleSummaryProvider="true" />
  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:key="seasonal_decoration" app:icon="@drawable/ic_mobile_pumpkin" app:title="@string/qmobile_seasonal" app:defaultValue="auto" app:entries="@array/qmobile_seasons" app:entryValues="@array/qmobile_season_values" app:useSimpleSummaryProvider="true" />
