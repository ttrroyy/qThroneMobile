<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
 <PreferenceCategory app:title="@string/settings_appearance">
  <moe.matsuri.nb4a.ui.ColorPickerPreference app:defaultValue="19" app:title="@string/qmobile_color" app:key="appTheme" app:icon="@drawable/ic_mobile_palette" />
  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:key="qmobileSurfaceTheme" app:icon="@drawable/ic_mobile_theme" app:title="@string/theme" app:persistent="false" app:entries="@array/qmobile_surface_themes" app:entryValues="@array/qmobile_surface_values" app:useSimpleSummaryProvider="true" />
  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:key="seasonal_decoration" app:icon="@drawable/ic_mobile_pumpkin" app:title="@string/qmobile_seasonal" app:defaultValue="auto" app:entries="@array/qmobile_seasons" app:entryValues="@array/qmobile_season_values" app:useSimpleSummaryProvider="true" />
  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:defaultValue="top" app:key="qmobileTilesPosition" app:icon="@drawable/ic_mobile_dock_bottom" app:title="@string/qmobile_tiles_position" app:entries="@array/qmobile_tiles_positions" app:entryValues="@array/qmobile_tiles_position_values" app:useSimpleSummaryProvider="true" />
  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:defaultValue="extended" app:key="qmobileHomeTilesMode" app:icon="@drawable/ic_mobile_dock_bottom" app:title="@string/qmobile_home_tiles" app:entries="@array/qmobile_home_tiles_entries" app:entryValues="@array/qmobile_home_tiles_values" app:useSimpleSummaryProvider="true" />
  <moe.matsuri.nb4a.ui.SimpleMenuPreference app:defaultValue="" app:entries="@array/language_entries" app:entryValues="@array/language_values" app:key="appLanguage" app:icon="@drawable/ic_mobile_language" app:title="@string/language" app:useSimpleSummaryProvider="true" />
 </PreferenceCategory>
 <PreferenceCategory app:title="@string/cag_notification">
  <SwitchPreference app:defaultValue="false" app:key="qmobileNotificationSpeed" app:icon="@drawable/ic_baseline_speed_24" app:title="@string/qmobile_notification_speed" />
 </PreferenceCategory>
</PreferenceScreen>
