<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="@string/cag_interface">
        <moe.matsuri.nb4a.ui.MTUPreference app:entries="@array/mtu_select" app:entryValues="@array/mtu_select" app:icon="@drawable/baseline_public_24" app:key="vpn_mtu" app:title="@string/mtu" />
        <SwitchPreference app:icon="@drawable/ic_image_looks_6" app:key="vpn_ipv6" app:summary="@string/vpn_ipv6_sum" app:title="@string/vpn_ipv6" />
        <SwitchPreference app:icon="@drawable/ic_baseline_legend_toggle_24" app:key="enable_tun_routing" app:summary="@string/enable_tun_routing_sum" app:title="@string/enable_tun_routing" />
        <SwitchPreference app:defaultValue="true" app:icon="@drawable/ic_baseline_legend_toggle_24" app:key="block_quic" app:summary="@string/block_quic_sum" app:title="@string/block_quic" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/cag_private_range_bypass">
        <SwitchPreference app:key="tunBypassPrivateRanges" app:persistent="false" app:summary="@string/bypass_private_ranges_sum" app:title="@string/bypass_private_ranges" />
        <app.qthrone.mobile.ui.settings.StringListPreference app:dialogMessage="@string/private_ranges_dialog_message" app:key="vpn_private_ranges" app:title="@string/private_ranges" />
        <Preference app:key="tunRestoreRanges" app:title="@string/restore_default_ranges" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/cag_tun_address">
        <EditTextPreference app:key="vpn_tun_ipv4_cidr" app:title="@string/tun_ipv4_cidr" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="vpn_tun_ipv6_cidr" app:title="@string/tun_ipv6_cidr" app:useSimpleSummaryProvider="true" />
        <Preference app:key="tunRestoreAddresses" app:title="@string/restore_default_addresses" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/cag_mixed_inbound">
        <SwitchPreference app:icon="@drawable/ic_baseline_block_24" app:key="disable_mixed_inbound" app:summary="@string/disable_mixed_inbound_sum" app:title="@string/disable_mixed_inbound" />
        <SwitchPreference app:key="random_inbound_port" app:summary="@string/random_inbound_port_sum" app:title="@string/random_inbound_port" />
        <SwitchPreference app:icon="@drawable/ic_baseline_nat_24" app:key="inboundAllowLan" app:persistent="false" app:summary="@string/allow_access_sum" app:title="@string/allow_access" />
        <SwitchPreference app:icon="@drawable/ic_baseline_http_24" app:key="appendHttpProxy" app:summary="@string/append_http_proxy_sum" app:title="@string/append_http_proxy" />
        <EditTextPreference app:dialogMessage="@string/http_proxy_bypass_dialog_message" app:icon="@drawable/ic_baseline_domain_24" app:key="httpProxyBypass" app:title="@string/http_proxy_bypass" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/cag_authentication">
        <SwitchPreference app:icon="@drawable/ic_baseline_lock_24" app:key="inbound_auth" app:summary="@string/inbound_auth_sum" app:title="@string/qmobile_socks_auth" />
        <SwitchPreference app:key="lan_sharing_enabled" app:defaultValue="false" app:title="@string/allow_access" app:summary="@string/lan_sharing_summary" app:icon="@drawable/ic_mobile_globe" />
        <EditTextPreference app:key="inbound_user" app:title="@string/qmobile_socks_user" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:key="inbound_pass" app:title="@string/qmobile_socks_pass" />
        <Preference app:key="qmobileResetSocks" app:title="@string/qmobile_socks_reset" />
        <Preference app:key="sharingAddresses" app:title="@string/lan_sharing_address" app:icon="@drawable/ic_mobile_globe" />
        <EditTextPreference app:icon="@drawable/ic_maps_directions_boat" app:key="inbound_socks_port" app:title="@string/local_socks_port" app:useSimpleSummaryProvider="true" />
        <EditTextPreference app:icon="@drawable/ic_maps_directions_boat" app:key="inbound_http_port" app:title="@string/local_http_port" app:useSimpleSummaryProvider="true" />
        <Preference app:key="sharingInstructions" app:selectable="false" app:summary="@string/lan_sharing_help" />
        <Preference app:key="sharingHotspot" app:title="@string/lan_sharing_hotspot" app:icon="@drawable/ic_mobile_hotspot" app:widgetLayout="@layout/qmobile_preference_arrow" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/cag_advanced">
        <EditTextPreference app:dialogMessage="@string/dns_in_port_dialog_message" app:icon="@drawable/ic_action_dns" app:key="core_dns_in_port" app:title="@string/dns_in_port" app:useSimpleSummaryProvider="true" />
        <moe.matsuri.nb4a.ui.EditConfigPreference app:icon="@drawable/ic_baseline_layers_24" app:jsonAllowEmpty="true" app:jsonSchema="#" app:key="custom_inbound" app:title="@string/custom_inbound" />
    </PreferenceCategory>
</PreferenceScreen>
