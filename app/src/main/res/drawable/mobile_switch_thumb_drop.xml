<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/switch_drop_on" android:state_checked="true" android:drawable="@drawable/mobile_switch_thumb_drop_shape" />
    <item android:id="@+id/switch_drop_off" android:drawable="@drawable/mobile_switch_thumb_drop_shape" />
    <transition android:fromId="@id/switch_drop_off" android:toId="@id/switch_drop_on" android:drawable="@drawable/mobile_switch_thumb_drop_move" />
    <transition android:fromId="@id/switch_drop_on" android:toId="@id/switch_drop_off" android:drawable="@drawable/mobile_switch_thumb_drop_move" />
</animated-selector>
