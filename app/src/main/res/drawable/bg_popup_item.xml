<?xml version="1.0" encoding="utf-8"?>
<!-- A menu row lights up as a rounded pill inside the rounded menu, not as a square past its corners.
     Layer offsets, not an inset: a list adds its selector's padding to every row and would cut the labels. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="@android:integer/config_shortAnimTime">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="6dp" android:right="6dp" android:top="2dp" android:bottom="2dp">
                <shape android:shape="rectangle"><corners android:radius="12dp" /><solid android:color="?attr/colorControlHighlight" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item android:left="6dp" android:right="6dp" android:top="2dp" android:bottom="2dp">
                <shape android:shape="rectangle"><corners android:radius="12dp" /><solid android:color="?attr/colorControlHighlight" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
